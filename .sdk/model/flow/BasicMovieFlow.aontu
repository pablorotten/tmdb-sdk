# BasicMovieFlow

main: kit: flow: BasicMovieFlow:
{
  entity: "movie",
  kind: "basic",
  name: "BasicMovieFlow",
  step: [
    {
      i: {
        ref: "movie_ref01"
      }

      m: {
        account_id: "account01",
        guest_session_id: "guest_session01",
        movie_id: "movie01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "movie_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "movie_ref01",
        srcdatavar: "movie_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "movie01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-movie_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "movie_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "movie01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "movie_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMovieFlow"
}