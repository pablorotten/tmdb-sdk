# BasicTvnFlow

main: kit: flow: BasicTvnFlow:
{
  entity: "tvn",
  kind: "basic",
  name: "BasicTvnFlow",
  step: [
    {
      i: {
        ref: "tvn_ref01"
      }

      m: {
        account_id: "account01",
        guest_session_id: "guest_session01",
        series_id: "series01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "tvn_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tvn_ref01",
        srcdatavar: "tvn_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "tvn01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-tvn_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "tvn_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "tvn01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "tvn_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTvnFlow"
}