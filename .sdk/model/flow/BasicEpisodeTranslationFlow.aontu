# BasicEpisodeTranslationFlow

main: kit: flow: BasicEpisodeTranslationFlow:
{
  entity: "episode_translation",
  kind: "basic",
  name: "BasicEpisodeTranslationFlow",
  step: [
    {
      m: {
        episode_number: "episode_number01",
        season_id: "season01",
        tv_id: "tv01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "episode_translation_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEpisodeTranslationFlow"
}