# BasicSeasonVideoFlow

main: kit: flow: BasicSeasonVideoFlow:
{
  entity: "season_video",
  kind: "basic",
  name: "BasicSeasonVideoFlow",
  step: [
    {
      m: {
        season_number: "season_number01",
        tv_id: "tv01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "season_video_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSeasonVideoFlow"
}